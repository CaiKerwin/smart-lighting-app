	"globalStyle": {
		// 除去导航栏的滚动条，只对APP和H5端生效
		//		"scrollIndicator": "none",
		//		"app-plus": {
		//			"scrollIndicator": "none"
		//		},
		"navigationBarTextStyle": "black",
		"navigationBarTitleText": "智慧照明",
		"navigationBarBackgroundColor": "#F8F8F8",
		"backgroundColor": "#F8F8F8",
		/**声明递归组件：
				* treeNode 会在自身模板中递归调用自己，
				* 小程序端和APP端只有在此声明后编译器才会把自身引用写入组件 usingComponents，
				* 否则只渲染根节点
				*/
		"usingComponents": {
			"tree-node": "/components/treeNode"
		}
	},
	"uniIdRouter": {
